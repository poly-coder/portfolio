# Supabase project settings (Epic 2)
# Copy to .env.local (or set values in your shell) and fill with real values.

# Supabase API
SUPABASE__URL=
SUPABASE__PUBLISHABLE_KEY=
SUPABASE__SECRET_KEY=

# Supabase Postgres connection parts
SUPABASE__DB_HOST=
SUPABASE__DB_PORT=5432
SUPABASE__DB_NAME=postgres
SUPABASE__DB_USER=postgres
SUPABASE__DB_PASSWORD=

# Optional single-value alternative for backend DB access.
# If set, this should include SSL mode/params required by Supabase.
SUPABASE__CONNECTION_STRING=
